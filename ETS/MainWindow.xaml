<Window x:Class="FixItHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:FixItHub.Helpers"
        Title="FixIt Hub - Manajemen Servis &amp; Garansi" Height="720" Width="1180"
        MinHeight="560" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <h:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Tombol navigasi sidebar -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,12" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol umum -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Badge status berwarna (DataTrigger) -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#9CA3AF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusServis}" Value="Antrean">
                    <Setter Property="Background" Value="#6B7280" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusServis}" Value="Proses">
                    <Setter Property="Background" Value="#F97316" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusServis}" Value="Siap Diambil">
                    <Setter Property="Background" Value="#3B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusServis}" Value="Selesai">
                    <Setter Property="Background" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusServis}" Value="Batal">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kartu statistik -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>

        <!-- DataGrid -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0F172A">
            <StackPanel>
                <StackPanel Margin="24,28,24,28">
                    <TextBlock Text="🔧 FixIt Hub" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Servis &amp; Garansi Elektronik" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" Content="📋  Daftar Servis"
                             IsChecked="{Binding IsServisTab, Mode=TwoWay}" />
                <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" Content="👥  Data Pelanggan"
                             IsChecked="{Binding IsPelangganTab, Mode=TwoWay}" />
                <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" Content="📊  Laporan &amp; Analytics"
                             IsChecked="{Binding IsLaporanTab, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- KONTEN -->
        <Grid Grid.Column="1">

            <!-- TAB 1: DAFTAR SERVIS -->
            <Grid Margin="28" Visibility="{Binding IsServisTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Daftar Servis" FontSize="24" FontWeight="Bold" Foreground="#111827"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#4B5563" />
                        <ComboBox Width="150" Padding="8,6"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilter}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="+ Tambah Servis Baru" Style="{StaticResource PrimaryButton}"
                            Command="{Binding BukaModalCommand}" />
                </Grid>

                <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding ServisView}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Nota" Binding="{Binding NoNota}" Width="150" />
                        <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="140" />
                        <DataGridTextColumn Header="Perangkat" Binding="{Binding Perangkat}" Width="150" />
                        <DataGridTextColumn Header="Keluhan" Binding="{Binding Keluhan}" Width="*" />
                        <DataGridTextColumn Header="Estimasi Biaya"
                                            Binding="{Binding EstimasiBiaya, StringFormat={}{0:C0}, ConverterCulture=id-ID}"
                                            Width="120" />
                        <DataGridTextColumn Header="Tgl Masuk"
                                            Binding="{Binding TanggalMasuk, StringFormat={}{0:dd MMM yyyy}, ConverterCulture=id-ID}"
                                            Width="100" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding StatusServis}" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ubah Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Padding="6,4"
                                              ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding StatusServis, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aksi" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✏ Edit" Style="{StaticResource WarnButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditServisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="🗑 Hapus" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.HapusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- TAB 2: DATA PELANGGAN -->
            <Grid Margin="28" Visibility="{Binding IsPelangganTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Data Pelanggan" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,18" />
                <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding DaftarPelanggan}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PelangganId}" Width="70" />
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="200" />
                        <DataGridTextColumn Header="No. Telepon" Binding="{Binding NoTelepon}" Width="160" />
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*" />
                        <DataGridTemplateColumn Header="Aksi" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✏ Edit" Style="{StaticResource WarnButton}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditPelangganCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="🗑 Hapus" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.HapusPelangganCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- TAB 3: LAPORAN & ANALYTICS -->
            <Grid Margin="28" Visibility="{Binding IsLaporanTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Laporan &amp; Analytics" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12" />
                <UniformGrid Grid.Row="1" Rows="1" Columns="4">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="💰 Total Pendapatan" Foreground="#6B7280" />
                            <TextBlock Text="{Binding TotalPendapatan, StringFormat={}{0:C0}, ConverterCulture=id-ID}"
                                       FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="✅ Servis Selesai" Foreground="#6B7280" />
                            <TextBlock Text="{Binding TotalSelesai}" FontSize="30" FontWeight="Bold"
                                       Foreground="#22C55E" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="🛠 Dalam Proses" Foreground="#6B7280" />
                            <TextBlock Text="{Binding TotalProses}" FontSize="30" FontWeight="Bold"
                                       Foreground="#F97316" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="⏳ Dalam Antrean" Foreground="#6B7280" />
                            <TextBlock Text="{Binding TotalAntrean}" FontSize="30" FontWeight="Bold"
                                       Foreground="#6B7280" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- MODAL OVERLAY -->
        <Grid Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="14" Width="460" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ModalTitle}" FontSize="20" FontWeight="Bold" Foreground="#111827" />

                        <TextBlock Text="Nama Pelanggan" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}"
                                 IsEnabled="{Binding IsTambahMode}"
                                 Text="{Binding NamaPelanggan, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="No. Telepon" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}"
                                 IsEnabled="{Binding IsTambahMode}"
                                 Text="{Binding NoTelepon, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Alamat" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding IsTambahMode}"
                                 Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Perangkat" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding Perangkat, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Keluhan" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}" Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Keluhan, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Estimasi Biaya (Rp)" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormInput}"
                                 Text="{Binding EstimasiBiayaText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Batal" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding BatalCommand}" />
                            <Button Content="Simpan" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SimpanCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL EDIT PELANGGAN -->
        <Grid Grid.ColumnSpan="2" Background="#99000000"
              Visibility="{Binding IsPelangganModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="14" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Pelanggan" FontSize="20" FontWeight="Bold" Foreground="#111827" />

                    <TextBlock Text="Nama" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource FormInput}"
                             Text="{Binding PelNama, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="No. Telepon" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource FormInput}"
                             Text="{Binding PelTelepon, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Alamat" Style="{StaticResource FormLabel}" />
                    <TextBox Style="{StaticResource FormInput}" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding PelAlamat, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding PelError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Batal" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Command="{Binding BatalPelangganCommand}" />
                        <Button Content="Simpan" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SimpanPelangganCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
