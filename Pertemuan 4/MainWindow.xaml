
<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App"
        Height="450" Width="500">

    <StackPanel Margin="20">
        <TextBlock Text="Student Registration App"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Text="NIM"/>
        <TextBox x:Name="txtNIM" Margin="0,5,0,10"/>

        <TextBlock Text="Nama Mahasiswa"/>
        <TextBox x:Name="txtNama" Margin="0,5,0,10"/>

        <TextBlock Text="Program Studi"/>
        <ComboBox x:Name="cmbProdi" Margin="0,5,0,10">
            <ComboBoxItem Content="Informatika"/>
            <ComboBoxItem Content="Sistem Informasi"/>
            <ComboBoxItem Content="Teknik Komputer"/>
        </ComboBox>

        <Button Content="Tambah Mahasiswa"
                Click="TambahMahasiswa_Click"
                Height="30" Margin="0,5,0,15"/>

        <TextBlock Text="Daftar Mahasiswa"
                   FontWeight="Bold"/>

        <ListBox x:Name="lstMahasiswa"
                 Height="130" Margin="0,5,0,0"/>
    </StackPanel>
</Window>
